{
  "name": "cocolla",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:engine && npm run build:web",
    "build:engine": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p apps/web/tsconfig.json --pretty false",
    "test": "npm run build:engine && node --test \"dist/packages/engine/test/*.test.js\" \"dist/apps/web/test/*.test.js\"",
    "benchmark": "npm run build:engine && node dist/packages/engine/benchmarks/pattern.benchmark.js",
    "check": "npm run typecheck && npm test && npm run benchmark"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
